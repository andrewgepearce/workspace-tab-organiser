{
  "manifest_version": 2,
  "name": "Workspace Tab Organiser",
  "version": "0.10.0",
  "description": "Workspace Tab Organiser groups the tabs in your current workspace by your own site rules, and previews every move before it happens.",
  "minimum_opera_version": "139.0",
  "developer": {
    "name": "andrewgepearce",
    "url": "https://github.com/andrewgepearce/workspace-tab-organiser"
  },
  "homepage_url": "https://github.com/andrewgepearce/workspace-tab-organiser",
  "options_page": "options.html",
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_icon": "icons/icon48.png",
    "default_title": "Workspace Tab Organiser",
    "default_popup": "popup.html"
  }
}
